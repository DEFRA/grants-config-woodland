              }
            ]
          },
          {
            "code": "STAGE_AGREEMENT_ACCEPTED",
            "statuses": [
              {
                "code": "PHASE_PRE_AWARD:STAGE_APPLICATION_COMPLETED:STATUS_APPLICATION_COMPLETED",
                "source": "CW",
                "mappedTo": "PHASE_PRE_AWARD:STAGE_APPLICATION_COMPLETED:STATUS_APPLICATION_COMPLETED"
              }
            ]
          }
        ]
      }
    ]
  },
  "version": "0.0.0"
}
